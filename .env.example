# Esporta Backend — environment variable NAMES only. Never commit real secrets.
# Copy to `.env` for local dev and fill in. On Vercel these are Project env vars.
# Each secret is read only by the module that needs it (see src/config).

# ---- Backend ----
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
# Comma-separated allow-list for CORS (production must NOT use *).
APP_ORIGIN=http://localhost:3000

# ---- Supabase (required) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side ONLY. Never ship to Flutter. Used only for actor-less privileged work.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudflare R2 (images) ----
# New backend uses R2_* names. The config layer also accepts the existing
# edge-function names (CLOUDFLARE_R2_*) so ops can reuse current secrets.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Optional explicit S3 endpoint (defaults to https://<account>.r2.cloudflarestorage.com)
R2_ENDPOINT=

# ---- Cloudflare Stream (videos / Shorts) ----
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# ---- Firebase / FCM (push) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste with literal \n or real newlines; the config layer normalises \n.
FIREBASE_PRIVATE_KEY=

# ---- Gmail SMTP (security email) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
# Gmail App Password, NOT the account password.
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ---- Security / internal ----
# Shared secret the DB uses to call internal backend webhooks (push/email nudge).
INTERNAL_WEBHOOK_SECRET=
# Optional at-rest encryption key for any sensitive backend-held value.
ENCRYPTION_KEY=

# ---- Rate limiting (requests per minute, per tier, per client IP) ----
# All optional; clamped to 1..1000 when set. Tiers: login (auth login),
# account-recovery (OTP start/verify), webhook (signatures/secret-gated),
# analytics-ingest, media (upload session mint/complete), public (profiles,
# search), default (everything else).
AUTH_LOGIN_RATE_LIMIT=
RECOVERY_RATE_LIMIT=
WEBHOOK_RATE_LIMIT=
ANALYTICS_RATE_LIMIT=
MEDIA_RATE_LIMIT=
PUBLIC_RATE_LIMIT=
DEFAULT_RATE_LIMIT=

# Account-level sign-in backoff (exponential, per TARGET account, IP-agnostic).
# After LOGIN_BACKOFF_THRESHOLD failed sign-ins within the failure window, each
# further failure multiplies the enforced wait (initial * multiplier^n), capped
# at LOGIN_BACKOFF_MAX_MS. State expires with the window — no permanent lockout.
LOGIN_BACKOFF_INITIAL_MS=
LOGIN_BACKOFF_MAX_MS=
LOGIN_BACKOFF_MULTIPLIER=
LOGIN_BACKOFF_WINDOW_MS=
LOGIN_BACKOFF_THRESHOLD=
